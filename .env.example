# =============================================================
# CVPro225 — variables d'environnement
# Copier en .env.local (dev) ou .env (prod, sur le serveur).
# NE JAMAIS versionner le fichier rempli.
# =============================================================

# ---------- Public (intégrées au bundle AU BUILD) ----------
# Toute modification de ces variables nécessite un rebuild de l'image.
NEXT_PUBLIC_APP_URL=https://cvpro225.com
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=contact@cvpro225.com
# Optionnel (CMS Strapi)
NEXT_PUBLIC_STRAPI_URL=

# ---------- Auth (NextAuth v5) ----------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=
# Obligatoire derrière un reverse proxy (Traefik)
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://cvpro225.com

# ---------- Supabase (SERVEUR uniquement — tables cv_leads / cv_analyses_log) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé service_role : contourne RLS. Secrète, jamais en NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Base de données (Supabase Postgres via Prisma) ----------
# App : pooler transactionnel (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations : connexion directe / session (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Email (Resend) ----------
RESEND_API_KEY=
ADMIN_EMAIL=admin@cvpro225.com
ADMIN_BCC_EMAIL=

# ---------- Paiement (PayDunya) — OPTIONNEL ----------
# Les 3 clés vides = paiement en ligne désactivé : build et démarrage OK, les
# clients voient « Paiement en ligne bientôt disponible, contactez-nous sur WhatsApp ».
# Renseigner les 3 ensemble (jamais partiellement).
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test | live
PAYDUNYA_MODE=test
# URLs de retour/annulation dérivées de NEXT_PUBLIC_APP_URL. Webhook optionnel (défaut : <APP_URL>/api/webhooks/paydunya)
PAYDUNYA_WEBHOOK_URL=https://cvpro225.com/api/webhooks/paydunya

# ---------- Offre de lancement ----------
# Dernier jour INCLUS des prix de lancement (heure d'Abidjan), format AAAA-MM-JJ.
# Lu par le serveur à chaque requête : le lendemain, les prix normaux s'appliquent
# partout automatiquement. Absente ou invalide = prix normaux. Grille : lib/offres.ts
# Changer la date : modifier ici puis `docker compose up -d app` (pas de rebuild).
LAUNCH_OFFER_END_DATE=2026-12-31

# ---------- IA (CV Checker) ----------
ANTHROPIC_API_KEY=
# Analyses gratuites par IP sur 24 h glissantes
CV_ANALYSIS_IP_LIMIT=1
# Plafond GLOBAL sur 24 h glissantes, toutes IP : au-delà, le service est coupé.
# Absent/invalide -> 100. 0 -> service fermé.
CV_ANALYSIS_GLOBAL_DAILY_LIMIT=100
# IP exemptées du plafond par IP (pas du plafond global), séparées par des virgules.
# En dev sans Traefik, l'IP vaut "unknown" : mettre unknown ici dans .env.local.
CV_RATE_LIMIT_WHITELIST=

# ---------- Optionnel ----------
STRAPI_URL=
STRAPI_API_TOKEN=
GOOGLE_VERIFICATION=

# ---------- Seed (uniquement pour `npx prisma db seed`, pas nécessaire en runtime) ----------
SEED_ADMIN_PASSWORD=
