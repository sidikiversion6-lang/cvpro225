# =============================================================
# CVPro225 — variables d'environnement
# Copier en .env.local (dev) ou .env (prod, sur le serveur).
# NE JAMAIS versionner le fichier rempli.
# =============================================================

# ---------- Public (intégrées au bundle AU BUILD) ----------
# Toute modification de ces variables nécessite un rebuild de l'image.
NEXT_PUBLIC_APP_URL=https://cvpro225.com
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=contact@cvpro225.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optionnel (CMS Strapi)
NEXT_PUBLIC_STRAPI_URL=

# ---------- Auth (NextAuth v5) ----------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=
# Obligatoire derrière un reverse proxy (Traefik)
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://cvpro225.com

# ---------- Base de données (Supabase Postgres via Prisma) ----------
# App : pooler transactionnel (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations : connexion directe / session (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Email (Resend) ----------
RESEND_API_KEY=
ADMIN_EMAIL=admin@cvpro225.com
ADMIN_BCC_EMAIL=

# ---------- Paiement (PayDunya) ----------
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test | live
PAYDUNYA_MODE=test
# URLs de retour/annulation dérivées de NEXT_PUBLIC_APP_URL. Webhook optionnel (défaut : <APP_URL>/api/webhooks/paydunya)
PAYDUNYA_WEBHOOK_URL=https://cvpro225.com/api/webhooks/paydunya

# ---------- IA (CV Checker) ----------
ANTHROPIC_API_KEY=

# ---------- Optionnel ----------
STRAPI_URL=
STRAPI_API_TOKEN=
GOOGLE_VERIFICATION=

# ---------- Seed (uniquement pour `npx prisma db seed`, pas nécessaire en runtime) ----------
SEED_ADMIN_PASSWORD=
