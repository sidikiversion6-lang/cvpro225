# Traefik — copier en .env (non versionné)

# Email de contact Let's Encrypt (alertes d'expiration)
ACME_EMAIL=

# ---- Mode Let's Encrypt ----
# Par défaut (variables commentées) : STAGING — certificats non reconnus par
# les navigateurs, mais sans limite de quota. À utiliser tant que le DNS
# n'est pas validé.
#
# Passage en PRODUCTION : décommenter les deux lignes ci-dessous, puis
#   docker compose up -d --force-recreate
# (fichier de stockage séparé : aucun certificat staging ne sera réutilisé)
#ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
#ACME_STORAGE=/letsencrypt/acme.json

# DEBUG | INFO | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO
