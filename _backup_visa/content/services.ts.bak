export interface ServiceHero {
  badge: string
  titre: string
  sousTitre: string
  ctaPrincipal: { label: string; href: string }
  ctaSecondaire: { label: string; href: string }
}

export interface Accroche {
  titre: string
  texte: string
}

export interface Prestation {
  titre: string
  description: string
  items?: string[]
}

export interface PackColonne {
  nom: string
  prix: string
  periode?: string
  recommande: boolean
}

export interface PackLigne {
  label: string
  valeurs: string[]
}

export interface PacksSection {
  colonnes: PackColonne[]
  lignes: PackLigne[]
  note?: string
}

export interface Etape {
  num: number
  titre: string
  description: string
}

export interface Temoignage {
  nom: string
  ville: string
  pack?: string
  note: number
  texte: string
}

export interface FAQItem {
  question: string
  reponse: string
}

export interface CtaFinal {
  titre: string
  btnPrincipal: { label: string; href: string }
  btnSecondaire: { label: string; href: string }
}

export interface SecteurLigne {
  secteur: string
  sources: string
}

export interface DestinationLigne {
  destination: string
  plateforme: string
  formulaire: string
}

