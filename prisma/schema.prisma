generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  nom           String
  prenom        String
  email         String    @unique
  emailVerified DateTime?
  telephone     String?
  ville         String?
  password      String?
  image         String?
  role          String    @default("client")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  commandes Commande[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Commande {
  id               String    @id @default(cuid())
  ref              String    @unique
  service          String
  pack             String
  nom              String
  prenom           String
  /// Optionnel depuis le parcours court (pas d'email client = pas d'email Resend client)
  email            String?
  telephone        String
  ville            String?
  statut           String    @default("pending")
  mode_paiement    String?
  montant          Int
  details          Json?
  message          String?
  paydunya_token   String?   @unique
  paydunya_status  String?
  paid_at          DateTime?
  /// Le client a-t-il fourni un CV existant ? null = commande antérieure à ce champ
  a_un_cv          Boolean?
  /// Chemin du CV fourni dans Supabase Storage (bucket privé "commandes-cv")
  cv_fichier       String?
  livraison_url    String?
  livraison_note   String?
  delivered_at     DateTime?
  user             User?     @relation(fields: [userId], references: [id])
  userId           String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  messages Message[]

  @@index([email])
  @@index([statut])
  @@index([service])
  @@index([userId])
  @@index([paydunya_token])
  @@index([a_un_cv])
  @@map("commandes")
}

model ServiceConfig {
  id          String   @id @default(cuid())
  slug        String   @unique
  nom         String
  icone       String
  couleur     String
  description String
  actif       Boolean  @default(true)
  packs       Pack[]
  updated_at  DateTime @updatedAt

  @@map("service_configs")
}

model Pack {
  id         String        @id @default(cuid())
  slug       String
  nom        String
  prix       Int
  devise     String        @default("GNF")
  delai      String
  recommande Boolean       @default(false)
  badge      String?
  actif      Boolean       @default(true)
  features   PackFeature[]
  service    ServiceConfig @relation(fields: [serviceId], references: [id])
  serviceId  String
  ordre      Int           @default(0)
  updated_at DateTime      @updatedAt

  @@unique([serviceId, slug])
  @@index([serviceId])
  @@map("packs")
}

model PackFeature {
  id     String  @id @default(cuid())
  label  String
  inclus Boolean @default(true)
  ordre  Int     @default(0)
  pack   Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId String

  @@index([packId])
  @@map("pack_features")
}

model SiteConfig {
  id         String   @id @default(cuid())
  cle        String   @unique
  valeur     String
  type       String   @default("text")
  groupe     String   @default("general")
  label      String
  updated_at DateTime @updatedAt

  @@map("site_configs")
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  titre      String
  message    String
  lu         Boolean  @default(false)
  lien       String?
  created_at DateTime @default(now())

  @@map("notifications")
}

model Message {
  id         String   @id @default(cuid())
  commande   Commande @relation(fields: [commandeId], references: [id])
  commandeId String
  auteur     String
  contenu    String
  lu         Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([commandeId])
  @@map("messages")
}
